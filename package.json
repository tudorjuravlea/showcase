{
  "name": "showcase",
  "private": true,
  "version": "0.1.0",
  "description": "Cinematic device-mockup videos and animated hero pages from a screen recording. Headless showcase CLI, Claude Code skill, and a two-renderer editor (CSS 3D + WebGL).",
  "author": "Tudor Juravlea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tudorjuravlea/showcase.git"
  },
  "homepage": "https://github.com/tudorjuravlea/showcase#readme",
  "bugs": "https://github.com/tudorjuravlea/showcase/issues",
  "keywords": [
    "device-mockup",
    "mockup",
    "screen-recording",
    "video",
    "webgl",
    "threejs",
    "css3d",
    "showcase",
    "hero-animation"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "predev": "npm run build:runtime",
    "dev": "vite",
    "prebuild": "npm run build:runtime",
    "build": "vite build",
    "pretest": "npm run build:runtime",
    "build:runtime": "npm run build:runtime:css && npm run build:runtime:gl",
    "build:runtime:css": "vite build --config vite.runtime.config.js",
    "build:runtime:gl": "MA_RUNTIME_TARGET=gl vite build --config vite.runtime.config.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "showcase": "node bin/showcase.mjs"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "mp4-muxer": "^5.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
